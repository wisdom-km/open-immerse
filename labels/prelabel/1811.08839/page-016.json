9d4aa9e3aef54","kind":"glyph","char":"better results with a regularization parameter of 0.1.","font":"CMR10","bbox":[72,709.09,323.82,720],"pathHash":"","ordinal":0,"label":"text","confidence":0.93,"rule":"body-font"},{"id":"e344b4f896c0ec17e","kind":"glyph","char":"16","font":"CMR10","bbox":[300.54,738.98,311.45,749.89],"pathHash":"","ordinal":0,"label":"text","confidence":0.93,"rule":"body-font"},{"id":"e28e7e8fba6ca7538","kind":"glyph","char":"","font":"","bbox":[231.99,403.89,246.51,419.16],"pathHash":"44afcc292ed5","ordinal":0,"label":"text","confidence":0.8,"rule":"body-font","source":"unbound-paint"},{"id":"ed11c0a43960af740","kind":"glyph","char":"","font":"","bbox":[250.16,399.92,260.08,419.56],"pathHash":"03900a3525c1","ordinal":0,"label":"text","confidence":0.8,"rule":"body-font","source":"unbound-paint"},{"id":"e13c2ba090af266c2","kind":"path","char":"","font":"","bbox":[259.66,294.39,265.12,294.39],"pathHash":"2ecac1589de0","ordinal":0,"label":"other","confidence":0.55,"rule":"path","source":"path"},{"id":"ea78a207d93656586","kind":"path","char":"","font":"","bbox":[259.87,400.14,419.88,400.14],"pathHash":"694360461fa4","ordinal":0,"label":"other","confidence":0.55,"rule":"path","source":"path"}],"units":[{"id":"u998a61d6d362","type":"inline","equationNumber":false,"confidence":0.96,"fallback":false,"elementIds":["e0aad99735365d4f0"]},{"id":"u9da146bb3367","type":"inline","equationNumber":false,"confidence":0.96,"fallback":false,"elementIds":["e51acb7e371bdd046"]},{"id":"u625d745e53a4","type":"inline","equationNumber":false,"confidence":0.96,"fallback":false,"elementIds":["e696b80612ea27aa1"]},{"id":"u000a606c0293","type":"display","equationNumber":true,"confidence":0.7,"fallback":false,"elementIds":["e6abee47da0ecf38a","e930ff84aaae8c7bc","e964eca6517447544","e910200bbe8905ef0","e471d3f9ba20ae972","e10f5d8354b048b63","e18c61541e7b0e2d8","eff632f2fcf3d328d","e7b3b06175d63f7de","ef24eec5bbc1c962b","ee8397fb877de129f","e32a546fc7e43c285","ed824656ebf3f2d5